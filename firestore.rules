rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Orders ───────────────────────────────────────────────────────────────
    // Anyone can create (public order form). address is now optional.
    // Only authenticated admins can read, update, or delete.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'name', 'phone', 'city',
          'productId', 'productName', 'price', 'quantity',
          'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.name   is string && request.resource.data.name.size()   > 0 && request.resource.data.name.size()    < 120
        && request.resource.data.phone  is string && request.resource.data.phone.size()  > 0 && request.resource.data.phone.size()   < 25
        && request.resource.data.city   is string && request.resource.data.city.size()   > 0 && request.resource.data.city.size()    < 80
        && request.resource.data.price    is number && request.resource.data.price    > 0
        && request.resource.data.quantity is int    && request.resource.data.quantity > 0;

      allow read, update, delete: if request.auth != null;
    }

    // ── Meta ─────────────────────────────────────────────────────────────────
    // orderCounter: public r/w (customer transaction increments it on order)
    // publicStats: public read, admin write
    match /meta/orderCounter {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /meta/publicStats {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Products (price/badge overrides) ──────────────────────────────────────
    // Public read so storefront can show overridden prices.
    // Only admin can write.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Stock ─────────────────────────────────────────────────────────────────
    match /stock/{productId} {
      allow read, write: if request.auth != null;
    }

    // ── Expenses (Finance / P&L) ──────────────────────────────────────────────
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
