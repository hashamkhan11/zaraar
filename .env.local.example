NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

NEXT_PUBLIC_WHATSAPP_NUMBER=923XXXXXXXXX
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your_tiktok_pixel_id
NEXT_PUBLIC_SITE_URL=https://zaraar.shop

# PostEx courier API
POSTEX_API_TOKEN=your_postex_api_token
# Get this from your PostEx merchant portal under Addresses/Pickup Addresses.
# Once set you never need to change it.
POSTEX_PICKUP_ADDRESS_CODE=your_pickup_address_code

# Firebase service account (server-side, for scheduled PostEx sync function).
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire contents of the downloaded JSON file as a single line here.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"..."}
